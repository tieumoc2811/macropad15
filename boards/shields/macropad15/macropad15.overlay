/*
 * Macropad 15 phim + 3 encoder EC11 - module Pro Micro RP2040
 *
 * So do phim (doc tu trai sang phai, tren xuong duoi), ten phim = c<cot>r<hang>:
 *
 *   c0r0  c0r1  c0r2  c0r3  c1r0
 *   c1r1  c1r2  c1r3  c2r0  c2r1
 *   c2r2  c2r3  c3r0  c3r1  c3r2
 *
 *   c3r3  = nut chuyen layer (&layer_cycle), dat canh c3r2 (vi tri vat ly chinh lai trong physical layout)
 *
 *   + 3 encoder (moi cai co nut nhan), nut nhan nam tren hang R4 cua ma tran.
 *
 * Ma tran 4 cot (C0-C3) x 5 hang (R0-R4), diode col2row (vach den cua diode
 * quay ve phia HANG: cong tac -> diode -> hang). Moi cong tac / nut nhan encoder
 * deu nen co 1 diode 1N4148 de khong bi ghosting.
 *   - C0..C3 la output, R0..R4 la input pull-down.
 *   - R0..R3: phim (c3r3 = nut layer cycle)
 *   - R4: nut nhan encoder: c0r4 = ENC1, c1r4 = ENC2, c2r4 = ENC3
 *
 * Gan chan (nhan Pro Micro -> GPIO RP2040):
 *
 *   C0 D7  GP7      R0 D1  GP1      ENC1 A D5  GP5
 *   C1 D8  GP8      R1 D0  GP0      ENC1 B D6  GP6
 *   C2 D21 GP29     R2 D2  GP2      ENC2 A D18 GP26
 *   C3 D20 GP28     R3 D3  GP3      ENC2 B D19 GP27
 *                   R4 D4  GP4      ENC3 A D15 GP22
 *                                   ENC3 B D16 GP23
 *
 * Con trong: D9, D10, D14 (khong dung).
 * Chan encoder A/B noi 1 chan vao GPIO, chan common noi GND, firmware bat pull-up.
 */

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/*
 * Tat I2C de giai phong cac chan D2/D3 (GP2/GP3) neu board bat I2C mac dinh tren do.
 * Khong dung I2C trong shield nay.
 */
&i2c0 {
    status = "disabled";
};

&i2c1 {
    status = "disabled";
};

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        debounce-press-ms = <5>;
        debounce-release-ms = <5>;

        /* C0 .. C3 */
        col-gpios
            = <&pro_micro 7  GPIO_ACTIVE_HIGH>   /* C0 D7  GP7  */
            , <&pro_micro 8  GPIO_ACTIVE_HIGH>   /* C1 D8  GP8  */
            , <&pro_micro 21 GPIO_ACTIVE_HIGH>   /* C2 D21 GP29 */
            , <&pro_micro 20 GPIO_ACTIVE_HIGH>   /* C3 D20 GP28 */
            ;

        /* R0 .. R4 */
        row-gpios
            = <&pro_micro 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* R0 D1 GP1 */
            , <&pro_micro 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* R1 D0 GP0 */
            , <&pro_micro 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* R2 D2 GP2 */
            , <&pro_micro 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* R3 D3 GP3 */
            , <&pro_micro 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* R4 D4 GP4 */
            ;
    };

    /*
     * Thu tu vi tri phim (position 0..17) trong keymap:
     *   0..14  : 15 phim theo thu tu doc cua so do (hang tren -> duoi, trai -> phai)
     *   15     : c3r3 = nut layer cycle
     *   16..18 : nut nhan encoder 1, 2, 3
     */
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <4>;
        rows = <5>;
        map = <
            RC(0,0) RC(1,0) RC(2,0) RC(3,0) RC(0,1)   /* c0r0 c0r1 c0r2 c0r3 c1r0 */
            RC(1,1) RC(2,1) RC(3,1) RC(0,2) RC(1,2)   /* c1r1 c1r2 c1r3 c2r0 c2r1 */
            RC(2,2) RC(3,2) RC(0,3) RC(1,3) RC(2,3)   /* c2r2 c2r3 c3r0 c3r1 c3r2 */
            RC(3,3)                                   /* c3r3: nut layer cycle    */
            RC(4,0) RC(4,1) RC(4,2)                   /* nut nhan ENC1 ENC2 ENC3  */
        >;
    };

    /*
     * Physical layout cho ZMK Studio. Don vi: 1/100 phim.
     * Thu tu phai TRUNG KHOP voi map cua default_transform o tren.
     * Hang encoder dat o tren cung (giua 5 cot) - chinh lai x/y neu PCB cua ban khac.
     */
    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Macropad15";
        transform = <&default_transform>;
        kscan = <&kscan0>;

        keys  //                     w    h    x    y    rot  rx   ry
            = <&key_physical_attrs 100 100    0  150      0   0    0>  /* c0r0 */
            , <&key_physical_attrs 100 100  100  150      0   0    0>  /* c0r1 */
            , <&key_physical_attrs 100 100  200  150      0   0    0>  /* c0r2 */
            , <&key_physical_attrs 100 100  300  150      0   0    0>  /* c0r3 */
            , <&key_physical_attrs 100 100  400  150      0   0    0>  /* c1r0 */

            , <&key_physical_attrs 100 100    0  250      0   0    0>  /* c1r1 */
            , <&key_physical_attrs 100 100  100  250      0   0    0>  /* c1r2 */
            , <&key_physical_attrs 100 100  200  250      0   0    0>  /* c1r3 */
            , <&key_physical_attrs 100 100  300  250      0   0    0>  /* c2r0 */
            , <&key_physical_attrs 100 100  400  250      0   0    0>  /* c2r1 */

            , <&key_physical_attrs 100 100    0  350      0   0    0>  /* c2r2 */
            , <&key_physical_attrs 100 100  100  350      0   0    0>  /* c2r3 */
            , <&key_physical_attrs 100 100  200  350      0   0    0>  /* c3r0 */
            , <&key_physical_attrs 100 100  300  350      0   0    0>  /* c3r1 */
            , <&key_physical_attrs 100 100  400  350      0   0    0>  /* c3r2 */

            , <&key_physical_attrs 100 100  400  450      0   0    0>  /* c3r3 layer cycle */

            , <&key_physical_attrs 100 100  100    0      0   0    0>  /* nut nhan ENC1 */
            , <&key_physical_attrs 100 100  200    0      0   0    0>  /* nut nhan ENC2 */
            , <&key_physical_attrs 100 100  300    0      0   0    0>  /* nut nhan ENC3 */
            ;
    };

    /*
     * 3 encoder EC11. Thu tu trong "sensors" = thu tu cac cap
     * binding trong sensor-bindings cua keymap (ENC1, ENC2, ENC3).
     * Neu xoay nguoc chieu: doi cho a-gpios va b-gpios, hoac doi thu tu CW/CCW trong keymap.
     * resolution = 4 cho loai co 4 xung / nac (pho bien). Neu 1 nac nhay 2 lan thi dat 2.
     */
    encoder_1: encoder_1 {
        compatible = "alps,ec11";
        a-gpios = <&pro_micro 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;   /* D5 GP5 */
        b-gpios = <&pro_micro 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;   /* D6 GP6 */
        resolution = <4>;
        status = "okay";
    };

    encoder_2: encoder_2 {
        compatible = "alps,ec11";
        a-gpios = <&pro_micro 18 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;  /* D18 GP26 */
        b-gpios = <&pro_micro 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;  /* D19 GP27 */
        resolution = <4>;
        status = "okay";
    };

    encoder_3: encoder_3 {
        compatible = "alps,ec11";
        a-gpios = <&pro_micro 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;  /* D15 GP22 */
        b-gpios = <&pro_micro 16 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;  /* D16 GP23 */
        resolution = <4>;
        status = "okay";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder_1 &encoder_2 &encoder_3>;
        triggers-per-rotation = <20>;
    };

    behaviors {
        /* &layer_cycle : Numpad -> Media -> Nokia -> Numpad ... (bo qua layer FN) */
        layer_cycle: layer_cycle {
            compatible = "zmk,behavior-layer-cycle";
            #binding-cells = <0>;
            display-name = "Layer Cycle";
            cycle-layers = <0 1 2>;
        };
    };
};
